generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth.js Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  audits        Audit[]
  locations     Location[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// GBP Audit Models
model Location {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // GBP Location identifiers (for future API integration)
  gbpAccountId    String?
  gbpLocationId   String?

  // Location Details (manual entry for Phase 1-3)
  name            String
  address         String?
  phone           String?
  website         String?
  primaryCategory String?

  audits          Audit[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model Audit {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationId    String
  location      Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)

  // Audit metadata
  status        AuditStatus   @default(PENDING)
  overallScore  Int?          // 0-100

  // Manual input data (JSON storage for flexibility)
  profileData   Json?         // Manually entered GBP profile data
  userInputs    Json?         // User-provided inputs (keywords, website hours, etc.)

  // Results
  results       AuditResult[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  completedAt   DateTime?

  @@index([userId])
  @@index([locationId])
}

enum AuditStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

model AuditResult {
  id          String       @id @default(cuid())
  auditId     String
  audit       Audit        @relation(fields: [auditId], references: [id], onDelete: Cascade)

  // Check identification
  category    String       // e.g., "categories", "description", "photos"
  checkId     String       // e.g., "primary_category_set", "description_exists"
  checkName   String       // Human readable name

  // Result
  status      CheckStatus
  score       Int          // 0-100 for this specific check
  message     String?      // Explanation or recommendation
  details     Json?        // Additional data about the check

  // For manual review items
  requiresManualReview Boolean @default(false)
  manualReviewNote     String?

  createdAt   DateTime     @default(now())

  @@index([auditId])
  @@unique([auditId, checkId])
}

enum CheckStatus {
  PASS
  FAIL
  WARNING
  MANUAL_REVIEW
  SKIPPED
}
